# ── Generic Ingestion Framework — environment template ──
# Copy to .env and fill in NON-SECRET values only.
# Secret values (API keys, DB passwords, client secrets) belong in `.env.dev`
# (gitignored) and are loaded with the `--env dev` flag. See `.env.dev.example`.

# ── SharePoint (metadata catalog) ──
# Prefer the Graph FILE_ID; URL becomes sites/{SITE_ID}/drive/items/{FILE_ID}.
# Falls back to CATALOG_PATH when no file id is set.
SHAREPOINT__FILE_ID=
SHAREPOINT__CATALOG_PATH=Available Data Source per Usecase.xlsx
SHAREPOINT__SITE_ID=telkomind.sharepoint.com,sites/SetnegTeam
SHAREPOINT__TENANT_ID=
SHAREPOINT__CLIENT_ID=
SHAREPOINT__CLIENT_SECRET=
# Base folder for Data Dictionary files; resolved as
# {DICTIONARY_BASE_PATH}/Data Dictionary - {sheet}/{Data Dictionary Name}
SHAREPOINT__DICTIONARY_BASE_PATH=Sitroom-2026/PROJECT/DATA/1 - Discover
# SHAREPOINT__CATALOG_FILE_ID=   # legacy alias of SHAREPOINT__FILE_ID
# SHAREPOINT__DRIVE_ID=          # only used when SHAREPOINT__SITE_ID is unset

# ── MinIO / S3 on-prem (PDF data access) ──
MINIO__ENDPOINT=localhost:9000
MINIO__ACCESS_KEY=
MINIO__SECRET_KEY=
MINIO__BUCKET=setneg-raw
MINIO__SECURE=false

# ── DEV database (dlt / elastic direct-write) ──
DEV__POSTGRES_HOST=localhost
DEV__POSTGRES_PORT=5432
DEV__POSTGRES_DB=ingestion_dev
DEV__POSTGRES_USER=dev
DEV__POSTGRES_PASSWORD=
DEV__POSTGRES_DATASET=ingestion_dev
# DEV__ELASTIC_URL=http://localhost:9200

# ── UC-01 Ketenagakerjaan ──
KETENAGAKERJAAN__KASUS_PERSELISIHAN__EXCEL__URL=https://satudata.kemnaker.go.id/data/kumpulan-data/3674
KETENAGAKERJAAN__KASUS_PERSELISIHAN__EXCEL__SCHEMA=raw
KETENAGAKERJAAN__KASUS_PERSELISIHAN__EXCEL__TABLE=kasus_perselisihan
# satudata is a JS SPA: its extractors render with Playwright by default
# (pip install playwright && playwright install chromium). Override if needed:
# KETENAGAKERJAAN__KASUS_PERSELISIHAN__EXCEL__DYNAMIC=false
# KETENAGAKERJAAN__KASUS_PERSELISIHAN__EXCEL__DOWNLOAD_SELECTOR=bg-satudata-800

KETENAGAKERJAAN__DATA_MOGOK_KERJA__EXCEL__URL=https://satudata.kemnaker.go.id/data/kumpulan-data/3616
KETENAGAKERJAAN__DATA_MOGOK_KERJA__EXCEL__TABLE=data_mogok_kerja
# Optional: bypass page rendering with the file URL (from Inspect Element).
# KETENAGAKERJAAN__DATA_MOGOK_KERJA__EXCEL__DOWNLOAD_URL=

KETENAGAKERJAAN__UPAH_MINIMUM_PROVINSI__EXCEL__URL=https://satudata.kemnaker.go.id/data/kumpulan-data/3005
KETENAGAKERJAAN__UPAH_MINIMUM_PROVINSI__EXCEL__TABLE=upah_minimum_provinsi

KETENAGAKERJAAN__BPS_INFLASI_YOY__SCRAPER__URL=https://www.bps.go.id/id/pressrelease
KETENAGAKERJAAN__BPS_INFLASI_YOY__SCRAPER__TABLE=bps_inflasi_yoy

KETENAGAKERJAAN__BPS_INFLASI_MOM__API__URL=https://www.bps.go.id/api/
KETENAGAKERJAAN__BPS_INFLASI_MOM__API__PAGINATION_TYPE=page
KETENAGAKERJAAN__BPS_INFLASI_MOM__API__PAGINATION_PARAM=page
KETENAGAKERJAAN__BPS_INFLASI_MOM__API__DATA_PATH=data
KETENAGAKERJAAN__BPS_INFLASI_MOM__API__TABLE=bps_inflasi_mom
# KETENAGAKERJAAN__BPS_INFLASI_MOM__API__API_KEY=   # secret -> NiFi property

KETENAGAKERJAAN__SIGNAL_KETENAGAKERJAAN__SCRAPER__URL=https://the-signal.id/rubrik/ketenagakerjaan.html
KETENAGAKERJAAN__SIGNAL_KETENAGAKERJAAN__SCRAPER__ITEM_SELECTOR=.card
KETENAGAKERJAAN__SIGNAL_KETENAGAKERJAAN__SCRAPER__FIELDS=[{"name":"title","selector":"h3"},{"name":"url","selector":"a","attr":"href"}]
KETENAGAKERJAAN__SIGNAL_KETENAGAKERJAAN__SCRAPER__TABLE=signal_ketenagakerjaan

# ── PDF data access example (download -> MinIO) ──
# EXAMPLE_USECASE__DOCUMENT__PDF__URL=https://example.go.id/regulasi
# EXAMPLE_USECASE__DOCUMENT__PDF__SELECTOR=a.download-pdf
# EXAMPLE_USECASE__DOCUMENT__PDF__MINIO_BUCKET=setneg-raw
# EXAMPLE_USECASE__DOCUMENT__PDF__MINIO_PREFIX=regulasi
