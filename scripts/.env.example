# ── Generic Ingestion Framework — environment template ──
# Copy to .env and fill in NON-SECRET values only.
# Secret values (API keys, DB passwords, client secrets) belong in `.env.dev`
# (gitignored) and are loaded with the `--env dev` flag. See `.env.dev.example`.

# ── SharePoint (metadata catalog) ──
# Prefer the Graph FILE_ID; URL becomes sites/{SITE_ID}/drive/items/{FILE_ID}.
# Falls back to CATALOG_PATH when no file id is set.
SHAREPOINT__FILE_ID=
SHAREPOINT__CATALOG_PATH=Available Data Source per Usecase.xlsx
SHAREPOINT__SITE_ID=telkomind.sharepoint.com,sites/SetnegTeam
SHAREPOINT__TENANT_ID=
SHAREPOINT__CLIENT_ID=
SHAREPOINT__CLIENT_SECRET=
# Base folder for Data Dictionary files; resolved as
# {DICTIONARY_BASE_PATH}/Data Dictionary - {sheet}/{Data Dictionary Name}
SHAREPOINT__DICTIONARY_BASE_PATH=Sitroom-2026/PROJECT/DATA/1 - Discover
# SHAREPOINT__CATALOG_FILE_ID=   # legacy alias of SHAREPOINT__FILE_ID
# SHAREPOINT__DRIVE_ID=          # only used when SHAREPOINT__SITE_ID is unset

# ── MinIO / S3 on-prem (PDF data access) ──
MINIO__ENDPOINT=localhost:9000
MINIO__ACCESS_KEY=
MINIO__SECRET_KEY=
MINIO__BUCKET=setneg-raw
MINIO__SECURE=false

# ── DEV database (dlt / elastic direct-write) ──
DEV__POSTGRES_HOST=192.168.15.16
DEV__POSTGRES_PORT=5432
DEV__POSTGRES_DB=setneg-stage
DEV__POSTGRES_USER=setneg-user
DEV__POSTGRES_PASSWORD=WhQOxluZC7n.cUjsPMwCmbpp~
DEV__POSTGRES_DATASET=ingestion_dev
# DEV__ELASTIC_URL=https://elasticsearch-sitroom.setneg.go.id/
# url: https://elasticsearch-sitroom.setneg.go.id/
# user: elastic
# pass: 94PQg~S8wQnjIo3CmlCzCzjd


# ── UC-01 Ketenagakerjaan ──
# Env format: {USECASE}__{PUBLISHER}__{SOURCE}__{ACCESS}__{KEY}
# Run by source, or all sources of a publisher (--publisher).

KETENAGAKERJAAN__KEMNAKER__KASUS_PERSELISIHAN__EXCEL__URL=https://satudata.kemnaker.go.id/data/kumpulan-data/3674
KETENAGAKERJAAN__KEMNAKER__KASUS_PERSELISIHAN__EXCEL__SCHEMA=raw
KETENAGAKERJAAN__KEMNAKER__KASUS_PERSELISIHAN__EXCEL__TABLE=kasus_perselisihan
# satudata is a JS SPA; configure a direct download URL for static extraction:
# KETENAGAKERJAAN__KEMNAKER__KASUS_PERSELISIHAN__EXCEL__DOWNLOAD_SELECTOR=bg-satudata-800

KETENAGAKERJAAN__KEMNAKER__DATA_MOGOK_KERJA__EXCEL__URL=https://satudata.kemnaker.go.id/data/kumpulan-data/3616
KETENAGAKERJAAN__KEMNAKER__DATA_MOGOK_KERJA__EXCEL__TABLE=data_mogok_kerja
# Optional: bypass page rendering with the file URL (from Inspect Element).
# KETENAGAKERJAAN__KEMNAKER__DATA_MOGOK_KERJA__EXCEL__DOWNLOAD_URL=

KETENAGAKERJAAN__KEMNAKER__UPAH_MINIMUM_PROVINSI__EXCEL__URL=https://satudata.kemnaker.go.id/data/kumpulan-data/3005
KETENAGAKERJAAN__KEMNAKER__UPAH_MINIMUM_PROVINSI__EXCEL__TABLE=upah_minimum_provinsi

KETENAGAKERJAAN__BPS__BPS_INFLASI_YOY__SCRAPER__URL=https://www.bps.go.id/id/pressrelease
KETENAGAKERJAAN__BPS__BPS_INFLASI_YOY__SCRAPER__TABLE=bps_inflasi_yoy

KETENAGAKERJAAN__BPS__BPS_INFLASI_MOM__API__URL=https://www.bps.go.id/api/
KETENAGAKERJAAN__BPS__BPS_INFLASI_MOM__API__PAGINATION_TYPE=page
KETENAGAKERJAAN__BPS__BPS_INFLASI_MOM__API__PAGINATION_PARAM=page
KETENAGAKERJAAN__BPS__BPS_INFLASI_MOM__API__DATA_PATH=data
KETENAGAKERJAAN__BPS__BPS_INFLASI_MOM__API__TABLE=bps_inflasi_mom
# KETENAGAKERJAAN__BPS__BPS_INFLASI_MOM__API__API_KEY=   # secret -> NiFi property

KETENAGAKERJAAN__GOODSTATS__UMK_SUMUT__SCRAPER__URL=https://data.goodstats.id/statistic/daftar-umk-sumatra-utara-2026-kota-medan-naik-8-RCShe
KETENAGAKERJAAN__GOODSTATS__UMK_SUMUT__SCRAPER__TABLE=umk_sumut
# goodstats is Cloudflare-protected; parse a saved page offline instead:
# KETENAGAKERJAAN__GOODSTATS__UMK_SUMUT__SCRAPER__SOURCE_FILE=./data/umk_sumut.html
# KETENAGAKERJAAN__GOODSTATS__UMK_SUMUT__SCRAPER__DYNAMIC=true

KETENAGAKERJAAN__THE_SIGNAL__SIGNAL_KETENAGAKERJAAN__SCRAPER__URL=https://the-signal.id/rubrik/ketenagakerjaan.html
KETENAGAKERJAAN__THE_SIGNAL__SIGNAL_KETENAGAKERJAAN__SCRAPER__ITEM_SELECTOR=.card
KETENAGAKERJAAN__THE_SIGNAL__SIGNAL_KETENAGAKERJAAN__SCRAPER__FIELDS=[{"name":"title","selector":"h3"},{"name":"url","selector":"a","attr":"href"}]
KETENAGAKERJAAN__THE_SIGNAL__SIGNAL_KETENAGAKERJAAN__SCRAPER__TABLE=signal_ketenagakerjaan

