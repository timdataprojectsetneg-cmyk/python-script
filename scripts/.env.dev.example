# ── Generic Ingestion Framework — environment template ──
# Copy to .env and fill in NON-SECRET values only.
# Secret values (API keys, DB passwords, client secrets) belong in the NiFi
# ExecuteStreamCommand sensitive properties or a secret manager.

# ── SharePoint (metadata catalog) ──
SHAREPOINT__CATALOG_PATH=Available Data Source per Usecase.xlsx
SHAREPOINT__SITE_ID=telkomind.sharepoint.com,sites/SetnegTeam
SHAREPOINT__TENANT_ID=
SHAREPOINT__CLIENT_ID=
SHAREPOINT__CLIENT_SECRET=
# SHAREPOINT__DRIVE_ID=

# ── Connection URIs (source of truth for loaders; credentials live here) ──
# When any (or several) of these is set, `python -m ingestion run` also runs the
# loader step — no --env dev needed — and loads to every sink whose URI is set.
# The same values can be passed per-run via --pg-uri / --elasticsearch-url /
# --minio-uri. Names are matched case-insensitively (PG_URI / pg_uri both work).
PG_URI=postgresql://user:password@postgres:5432/mydb
ELASTICSEARCH_URL=http://elastic:password@elasticsearch:9200
MINIO_URI=http://bigaction:xxxxx@minio-api-sitroom.setneg.go.id/raw?secure=true

# ── Loader options (non-credential; optional) ──
DEV__POSTGRES_DATASET=ingestion_dev   # default Postgres schema when a source has no POSTGRE_SCHEMA
ELASTIC__VERIFY_CERTS=true            # Elasticsearch TLS verification (default true)
# ELASTIC__API_KEY=                   # optional; or embed user:password in ELASTICSEARCH_URL
# ELASTIC__INDEX=                     # optional default index; config es_index/table/source wins
# MINIO__CA_CERT=/etc/ssl/minio-ca.pem  # CA/intermediate bundle when MinIO does not serve its full chain
# MINIO__TLS_VERIFY=false             # dev-only: skip MinIO TLS verification (or MINIO_URI ?verify=false)
# Legacy fallbacks (only if a URI is not set): MINIO__ENDPOINT/ACCESS_KEY/SECRET_KEY/BUCKET/SECURE,
# DEV__POSTGRES_HOST/PORT/DB/USER/PASSWORD

# ── BPS WebAPI key (secret; used by the BPS API extractors) ──
# BPS_WEBAPI_KEY=

# ── Scraper anti-bot credentials (per source, secrets) ──
# Refresh from a browser session that already passed the "are you human" check:
# DevTools → Network → copy the request's Cookie header, User-Agent, and the
# security_token query parameter. Keys are prefixed with the source env segment.
# KETENAGAKERJAAN__MAHKAMAH_AGUNG_RI__DIREKTORI_PUTUSAN_PERKARA_PENGADILAN_HUBUNGAN__TOKEN=
# KETENAGAKERJAAN__MAHKAMAH_AGUNG_RI__DIREKTORI_PUTUSAN_PERKARA_PENGADILAN_HUBUNGAN__USER_AGENT=
# KETENAGAKERJAAN__MAHKAMAH_AGUNG_RI__DIREKTORI_PUTUSAN_PERKARA_PENGADILAN_HUBUNGAN__COOKIE=
